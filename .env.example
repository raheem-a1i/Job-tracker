# Copy this file to .env (in the project root) and fill in values.

# Extraction provider: local | heuristic
#   local     = in-process zero-shot model classifies role (needs ~1GB RAM;
#               downloads the model once on first run, then runs offline)
#   heuristic = free rule-based extractor, no model (default)
AI_PROVIDER=heuristic
# Hugging Face model id for AI_PROVIDER=local role classifier (cached on first run)
LOCAL_AI_MODEL=Xenova/nli-deberta-v3-small
# Max postings sent to the local model per refresh; the rest use the heuristic.
# The local model is free, so raise this to cover all postings (slower refresh).
AI_MAX_JOBS=300

# Server port
PORT=4000

# Where JSON data is stored; point at a mounted disk/volume for persistence.
DATA_DIR=

# Comma-separated source adapters: remotive, remoteok, adzuna, arbeitnow, sample
SOURCES=remotive,remoteok
# Max postings to fetch per source per refresh
SOURCE_LIMIT=80

# Adzuna (only needed if 'adzuna' is in SOURCES). Free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code: us, gb, au, ca, de, fr, in, nl, etc.
ADZUNA_COUNTRY=us
