# Copy this file to .env (in the project root) and fill in values.

# Enables Claude extraction (and the Job Fit Coach). Without it, extraction
# automatically falls back to the keyword heuristic; the coach returns an error.
ANTHROPIC_API_KEY=

# Claude model + extraction tuning. claude-sonnet-5 is ~5x cheaper than opus
# for bulk extraction; use claude-opus-4-8 for higher quality.
CLAUDE_MODEL=claude-sonnet-5
# Max postings sent to Claude per refresh (cost guard). The rest use the free
# heuristic. Keep this modest to control spend.
AI_MAX_JOBS=60
# How many Claude requests to run in parallel.
AI_CONCURRENCY=5

# Backend port (hosts inject their own)
PORT=4000

# Comma-separated source adapters: remotive, remoteok, adzuna, arbeitnow, sample
SOURCES=remotive,remoteok,arbeitnow
# Max postings to fetch per source per refresh
SOURCE_LIMIT=200

# Adzuna (only needed if 'adzuna' is in SOURCES). Free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code: us, gb, au, ca, de, fr, in, nl, etc.
ADZUNA_COUNTRY=us
